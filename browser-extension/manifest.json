{
  "manifest_version": 3,
  "name": "WorkIntel Browser Tracker",
  "version": "1.0.0",
  "description": "Domain-only browser activity tracking for Workforce Intelligence.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "WorkIntel Browser Tracker",
    "default_popup": "popup.html"
  }
}
