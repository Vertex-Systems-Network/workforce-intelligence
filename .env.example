# WorkIntel application identity.
APP_NAME=WorkIntel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Local zero-install database. Production deployments can switch this to mysql.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Cache, queue, session, and filesystem defaults that work without external services.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Logging.
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Mail is written to the application log until a real provider is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@workintel.local"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend / Sanctum defaults for local Laravel + Vite development.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# WorkIntel desktop and browser tracking defaults.
WORKINTEL_AGENT_HEARTBEAT_SECONDS=30
WORKINTEL_AGENT_ONLINE_THRESHOLD_SECONDS=90
WORKINTEL_AGENT_ENROLLMENT_MINUTES=10
WORKINTEL_AGENT_TOKEN_DAYS=365
WORKINTEL_AGENT_SYNC_BATCH_MAX=500
WORKINTEL_AGENT_LATEST_VERSION=1.2.2
WORKINTEL_AGENT_MINIMUM_VERSION=1.0.0
WORKINTEL_BROWSER_HEARTBEAT_SECONDS=60
WORKINTEL_BROWSER_SYNC_SECONDS=60
WORKINTEL_BROWSER_SYNC_BATCH_MAX=250
WORKINTEL_BROWSER_TOKEN_DAYS=365

# Screenshot and reporting storage.
WORKINTEL_SCREENSHOT_DISK=local
WORKINTEL_SCREENSHOT_PRUNE_CHUNK=500
WORKINTEL_REPORT_DISK=local
WORKINTEL_REPORT_PREVIEW_ROWS=200
WORKINTEL_REPORT_MAX_ROWS=20000
WORKINTEL_REPORT_MAX_RANGE_DAYS=730
WORKINTEL_REPORT_RETENTION_DAYS=90

# Live workforce / client portal defaults.
WORKINTEL_LIVE_REFRESH_SECONDS=5
WORKINTEL_TIMELINE_MAX_DAYS=31
WORKINTEL_CLIENT_PORTAL_TOKEN_DAYS=30
WORKINTEL_CLIENT_PORTAL_INVITE_HOURS=72
WORKINTEL_CLIENT_INVOICE_DUE_DAYS=14

# SaaS billing and commerce. Production operator emails must be explicitly configured.
WORKINTEL_BILLING_PROVIDER=manual
WORKINTEL_BILLING_GRACE_DAYS=7
WORKINTEL_BILLING_ALLOW_MANUAL_SETTLEMENT=false
WORKINTEL_PLATFORM_OPERATOR_EMAILS=
WORKINTEL_DUNNING_MAX_ATTEMPTS=4

# Production hardening.
WORKINTEL_REQUIRE_SCHEDULER_HEARTBEAT=false
WORKINTEL_SCHEDULER_MAX_AGE_SECONDS=180
WORKINTEL_HSTS_SECONDS=0
WORKINTEL_SHOW_DEMO_ACCOUNTS=true
WORKINTEL_API_RATE_LIMIT_PER_MINUTE=120
WORKINTEL_API_TOKEN_DAYS=365
WORKINTEL_AUDIT_RETENTION_DAYS=365
WORKINTEL_WEBHOOK_RETENTION_DAYS=30
WORKINTEL_WEBHOOK_TIMEOUT_SECONDS=10
WORKINTEL_ALLOW_PRIVATE_WEBHOOKS=false

# Optional Reverb realtime chat. Leave unset when using polling fallback.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Chat V2.5 performance and attachment safety
WORKINTEL_CHAT_PAGE_SIZE=60
WORKINTEL_CHAT_PAGE_SIZE_MAX=100
WORKINTEL_CHAT_CLIENT_WINDOW_MAX=600
WORKINTEL_CHAT_ATTACHMENT_COUNT_MAX=8
WORKINTEL_CHAT_ATTACHMENT_SIZE_KB=20480
WORKINTEL_CHAT_ATTACHMENT_TOTAL_MB=60
WORKINTEL_CHAT_BLOCKED_EXTENSIONS=exe,com,scr,msi,bat,cmd,ps1

# Media Library
WORKINTEL_MEDIA_MAX_FILE_MB=100
WORKINTEL_MEDIA_MAX_FILES_PER_UPLOAD=20

# Document Studio V4 rendering
DOCUMENT_PDF_DRIVER=auto
DOCUMENT_CHROMIUM_BINARY=
DOCUMENT_RENDER_TIMEOUT=35
DOCUMENT_MAX_EMBEDDED_IMAGE_BYTES=5242880
DOCUMENT_CODE_PYTHON_BINARY=

# Production Operations & Disaster Recovery (Block K)
WORKINTEL_BACKUP_DISK=local
WORKINTEL_BACKUP_STORAGE_PATHS=private,hris,platform,screenshots
WORKINTEL_BACKUP_EXCLUDED_PATHS=private/system-backups,private/backup-runtime,private/document-render
WORKINTEL_MYSQLDUMP_BINARY=mysqldump
WORKINTEL_MYSQL_BINARY=mysql
WORKINTEL_PG_DUMP_BINARY=pg_dump
WORKINTEL_PSQL_BINARY=psql
# Keep false during normal operation. Enable only inside an approved production restore maintenance window.
WORKINTEL_ALLOW_DISASTER_RESTORE=false

# Observability & Audit Operations (Block L)
WORKINTEL_OBSERVABILITY_SLOW_REQUEST_MS=1200
WORKINTEL_OBSERVABILITY_SLOW_QUERY_MS=350
WORKINTEL_OBSERVABILITY_DEDUPE_MINUTES=15
WORKINTEL_OBSERVABILITY_RETENTION_DAYS=30
# Dashboard alerts are always persisted. Enable only after production mail is configured.
WORKINTEL_OBSERVABILITY_EMAIL_ALERTS=false
WORKINTEL_DIAGNOSTICS_RETENTION_HOURS=24


# Block M — Security Production Hardening
WORKINTEL_CSP_ENABLED=false
WORKINTEL_CSP_REPORT_ONLY=false
WORKINTEL_API_ROTATION_WARNING_DAYS=90
WORKINTEL_MALWARE_DRIVER=none
WORKINTEL_MALWARE_REQUIRED=false
WORKINTEL_CLAMAV_BINARY=clamscan
WORKINTEL_MALWARE_TIMEOUT_SECONDS=20
WORKINTEL_RATE_AUTH_LOGIN=10
WORKINTEL_RATE_AUTH_REGISTER=5
WORKINTEL_RATE_PASSWORD_RESET=5
WORKINTEL_RATE_PUBLIC_FORM=20
WORKINTEL_RATE_MEDIA_UPLOAD=60
WORKINTEL_SIGNED_DOCUMENT_MINUTES=5
