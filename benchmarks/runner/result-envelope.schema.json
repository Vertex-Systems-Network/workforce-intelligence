{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkIntel Runner Benchmark Exact-Head Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "candidate_source_identity",
    "dedup_key",
    "authorization",
    "execution_identity",
    "status",
    "started_at",
    "completed_at",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^RB-[0-9]{3,}$"
    },
    "candidate_source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "head_sha"
      ],
      "properties": {
        "repository": {
          "const": "Vertex-Systems-Network/workforce-intelligence"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "dedup_key": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "authority_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "repository-policy",
            "explicit-current"
          ]
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "authorized_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "granted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "matrix",
        "inputs",
        "fixtures"
      ],
      "properties": {
        "environment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "immutable"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "immutable": {
            "const": true
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
